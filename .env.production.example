# ==============================================================================
# AGENTIC UPI COMMERCE BRIDGE — PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ==============================================================================
# Copy this file to .env on your production host to activate live financial rails,
# cloud hardware HSM signing, and real-time merchant catalog webhooks.

# ------------------------------------------------------------------------------
# 1. LIVE RAZORPAY S2S AUTOPAY CREDENTIALS (STAGE 5: REAL MONEY)
# ------------------------------------------------------------------------------
# Obtain from: https://dashboard.razorpay.com/#/app/keys (Live Mode)
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=rzp_live_replace_with_live_key_id
RAZORPAY_KEY_SECRET=replace_with_live_key_secret
RAZORPAY_WEBHOOK_SECRET=whsec_replace_with_webhook_secret

# ------------------------------------------------------------------------------
# 2. HARDWARE ENCLAVE & KMS SIGNER (STAGE 4: REAL VERIFICATION)
# ------------------------------------------------------------------------------
# AWS KMS / CloudHSM ECDSA P-256 Key ARN (FIPS 140-2 Level 3 compliant)
# When set, the vault delegates ES256 mandate signing to hardware rather than RAM.
AWS_KMS_KEY_ARN=arn:aws:kms:ap-south-1:123456789012:key/replace-with-kms-key-uuid
AWS_REGION=ap-south-1

# ------------------------------------------------------------------------------
# 3. ENTERPRISE IMMUTABLE LEDGER & IDEMPOTENCY DB (STAGE 5: SERIALIZABLE)
# ------------------------------------------------------------------------------
# Connection string to PostgreSQL 15+ cluster (AWS RDS / Neon / Supabase)
DATABASE_URL=postgresql://ledger_admin:replace_secure_pass@db.prod.ap2bridge.net:5432/agentic_upi?sslmode=require

# ------------------------------------------------------------------------------
# 4. REAL COMMERCE ENGINE CONNECTORS (STAGE 3: REAL PRODUCTS)
# ------------------------------------------------------------------------------
# Shopify Admin GraphQL API Integration
SHOPIFY_SHOP_URL=your-store-name.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_replace_with_admin_access_token

# ONDC (Open Network for Digital Commerce) Beckn Protocol BAP Node
ONDC_GATEWAY_URL=https://prod.gateway.ondc.org
ONDC_SUBSCRIBER_ID=ap2-gateway.yourdomain.com
ONDC_SIGNING_PRIVATE_KEY=replace_with_ed25519_signing_key_base64

# Logistics Integration (Delhivery B2B Airway Bills)
DELHIVERY_API_TOKEN=replace_with_delhivery_api_token

# ------------------------------------------------------------------------------
# 5. REASONING CORE & LLM GATEWAY (STAGE 2)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=replace_with_production_gemini_api_key
OPENROUTER_API_KEY=replace_with_production_openrouter_api_key
GROQ_API_KEY=replace_with_production_groq_api_key

# ------------------------------------------------------------------------------
# 6. APPLICATION PORTS & NETWORKING
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=production
